<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Cluster Inventory API conformance report</title>
    <style>
        table, th, td {
            border: 1px solid black;
        }
        td {
            padding: 2px;
        }
    </style>
</head>
<body>
<h2>Cluster Inventory API Conformance Report</h2>
<p><strong>{{.Passed}}</strong> of <strong>{{.Total}}</strong> tests passed</p>

{{if or .Implementation.Project .Implementation.Organization .Implementation.Version .Implementation.URL}}
    <p>Implementation:{{if .Implementation.Project}} <strong>{{.Implementation.Project}}</strong>{{end}}{{if .Implementation.Version}} {{.Implementation.Version}}{{end}}{{if .Implementation.Organization}} ({{.Implementation.Organization}}){{end}}{{if .Implementation.URL}} - <a href="{{.Implementation.URL}}">{{.Implementation.URL}}</a>{{end}}</p>
{{end}}

{{if .SuiteFailure }}
    <p style="color: red">{{.SuiteFailure}}</p>
{{end}}

{{range .APIs}}
<h3>{{.Name}} API - {{.Passed}} of {{.Total}} tests passed</h3>
{{range .Groups}}
<h4>{{.Name}}</h4>
<table>
    <thead>
        <tr>
            <th>Conformant</th>
            <th>Labels</th>
            <th>Description</th>
        </tr>
    </thead>
    {{range .Tests}}
    <tr>
        {{ if .Skipped }}
            <td style="color:gray">Skipped{{.Message}}</td>
        {{ else if .Failed }}
            <td style="color:orange">Unknown{{.Message}}</td>
        {{ else if .Conformant }}
            <td style="color:green">Yes{{.Message}}</td>
        {{ else }}
            <td style="color:red">No{{.Message}}</td>
        {{end}}
        <td>{{range $i, $l := .Labels}}{{if $i}}, {{end}}{{$l}}{{end}}</td>
        <td><a href="{{.Ref}}">{{.Desc}}</a></td>
    </tr>
    {{end}}
</table>
{{end}}
{{end}}
</body>
</html>
